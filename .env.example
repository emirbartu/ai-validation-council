# ─── LLM Provider (OpenAI-compatible) ───
# Set your API key and optionally override base_url in Settings.
# Any OpenAI-compatible provider works.
LLM_API_KEY=sk-...

# ─── Data Collection ───
# Serper API for Reddit search
# Get yours at: https://serper.dev/
SERPER_API_KEY=your-serper-key

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql+asyncpg://council:council@localhost:5432/council

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ───
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Spending Limits (USD/day) ───
LLM_DAILY_LIMIT=50.0
MAX_ANALYSES_PER_USER_PER_DAY=5
MAX_CONCURRENT_ANALYSES=3

# ─── Environment ───
ENVIRONMENT=development
LOG_LEVEL=INFO
